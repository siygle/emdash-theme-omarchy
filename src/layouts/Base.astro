---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { palettes } from "../palettes";
import { PALETTE_COOKIE, themeConfig } from "../theme.config";
import "../styles/tokens.css";
import "../styles/wm.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;

// Menu items become numbered Hyprland workspaces; the current page's is active
const pathname = Astro.url.pathname;
function isCurrent(url: string) {
	const target = new URL(url, Astro.url);
	if (target.origin !== Astro.url.origin) return false;
	if (target.pathname === "/") return pathname === "/";
	return pathname === target.pathname || pathname.startsWith(`${target.pathname}/`);
}

const defaultPalette =
	palettes.find((palette) => palette.id === themeConfig.defaultPalette) ?? palettes[0];
const paletteIds = palettes.map((palette) => palette.id);
---

<!doctype html>
<html lang="en" data-palette={defaultPalette.id}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" preload />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline define:vars={{ paletteIds, cookieName: PALETTE_COOKIE }}>
			// Apply a saved palette before first paint to prevent a flash.
			var row = document.cookie.split("; ").find(function (item) {
				return item.startsWith(cookieName + "=");
			});
			var saved = row ? row.slice(cookieName.length + 1) : null;
			if (saved && paletteIds.indexOf(saved) !== -1) {
				document.documentElement.dataset.palette = saved;
			}
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="waybar">
			<nav class="waybar-group waybar-left" aria-label="Primary">
				<a href="/" class="waybar-brand">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								class="waybar-logo"
							/>
						) : (
							<span class="waybar-brand-mark" aria-hidden="true">
								◆
							</span>
						)
					}
					<span class="waybar-brand-title">{siteTitle}</span>
				</a>
				{
					menu?.items.map((item, index) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							class="workspace"
							aria-current={isCurrent(item.url) ? "page" : undefined}
						>
							<span class="workspace-num">{index + 1}</span>
							<span class="workspace-label">{item.label}</span>
						</a>
					))
				}
			</nav>

			{
				themeConfig.clock && (
					<time class="waybar-clock" data-waybar-clock aria-hidden="true" />
				)
			}

			<div class="waybar-group waybar-right">
				<LiveSearch
					placeholder="search ⌘K"
					class="site-search"
					inputClass="site-search-input"
					resultsClass="site-search-results"
					resultClass="site-search-result"
					collections={["posts", "pages"]}
				/>
				{
					themeConfig.paletteSwitcher && (
						<details class="palette-picker" data-palette-picker>
							<summary class="waybar-module" aria-label="Choose color palette">
								<span class="palette-dot" aria-hidden="true" />
								<span class="palette-current" data-palette-current>
									{defaultPalette.name}
								</span>
							</summary>
							<div class="palette-menu" role="listbox" aria-label="Color palettes">
								{palettes.map((palette) => (
									<button
										type="button"
										role="option"
										class="palette-option"
										data-palette-option={palette.id}
										aria-selected={palette.id === defaultPalette.id ? "true" : "false"}
									>
										<span
											class="palette-swatch"
											style={`--sw-bg: ${palette.swatch[0]}; --sw-fg: ${palette.swatch[1]}; --sw-accent: ${palette.swatch[2]};`}
											aria-hidden="true"
										/>
										<span class="palette-name">{palette.name}</span>
										<span class="palette-mode">{palette.mode}</span>
									</button>
								))}
							</div>
						</details>
					)
				}
				<a href="/rss.xml" class="waybar-module" aria-label="RSS feed">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
						><circle cx="6.18" cy="17.82" r="2.18"></circle><path
							d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"
						></path></svg
					>
				</a>
				{
					isLoggedIn && (
						<a href="/_emdash/admin" class="waybar-module nav-admin">
							admin
						</a>
					)
				}
			</div>
		</header>

		<main class="desktop">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-pane" data-window="~/.config/site">
				<div class="footer-grid">
					<div class="footer-brand">
						<a href="/" class="footer-logo">
							{
								siteLogo ? (
									<img
										src={siteLogo.url}
										alt={siteLogo.alt || siteTitle}
										class="footer-logo-img"
									/>
								) : (
									siteTitle
								)
							}
						</a>
						<p class="footer-tagline">{siteTagline}</p>
					</div>
					<div class="footer-nav">
						<h2 class="footer-heading">navigate</h2>
						<ul class="footer-links">
							{
								menu?.items.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
										>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
					<div class="footer-nav">
						<h2 class="footer-heading">connect</h2>
						<ul class="footer-links">
							<li><a href="/rss.xml">rss feed</a></li>
						</ul>
					</div>
					<div class="footer-widgets-section">
						<WidgetArea name="footer" />
					</div>
				</div>
			</div>
			<div class="statusline">
				<div class="statusline-bar">
					<span><span class="statusline-ok">●</span> {siteTitle}</span>
					<span>
						powered by <a href="https://emdashcms.com">EmDash</a>
						<span class="statusline-sep">│</span>
						<span data-palette-current>{defaultPalette.name}</span>
					</span>
				</div>
			</div>
		</footer>

		<script>
			import { PALETTE_COOKIE } from "../theme.config";

			// Palette picker: set <html data-palette>, remember it, sync labels
			function setCookie(name: string, value: string, maxAge = 31536000) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
			}

			function syncPaletteUi() {
				const active = document.documentElement.dataset.palette;
				document.querySelectorAll<HTMLButtonElement>("[data-palette-option]").forEach((option) => {
					const selected = option.dataset.paletteOption === active;
					option.setAttribute("aria-selected", String(selected));
					if (selected) {
						const name = option.querySelector(".palette-name")?.textContent ?? "";
						document.querySelectorAll("[data-palette-current]").forEach((label) => {
							label.textContent = name;
						});
					}
				});
			}

			document.querySelectorAll<HTMLButtonElement>("[data-palette-option]").forEach((option) => {
				option.addEventListener("click", () => {
					const id = option.dataset.paletteOption;
					if (!id) return;
					document.documentElement.dataset.palette = id;
					setCookie(PALETTE_COOKIE, id);
					syncPaletteUi();
					option.closest("details")?.removeAttribute("open");
				});
			});

			// Close the picker on outside click or Escape
			const picker = document.querySelector<HTMLDetailsElement>("[data-palette-picker]");
			document.addEventListener("click", (event) => {
				if (picker?.open && !picker.contains(event.target as Node)) picker.open = false;
			});
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && picker?.open) {
					picker.open = false;
					picker.querySelector("summary")?.focus();
				}
			});

			syncPaletteUi();

			// Waybar clock (client-side: the server's clock is UTC)
			const clock = document.querySelector<HTMLElement>("[data-waybar-clock]");
			if (clock) {
				const format = new Intl.DateTimeFormat(undefined, {
					weekday: "short",
					day: "2-digit",
					month: "short",
					hour: "2-digit",
					minute: "2-digit",
				});
				const tick = () => {
					clock.textContent = format.format(new Date()).replaceAll(",", "");
				};
				tick();
				setInterval(tick, 30_000);
			}
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" (template defaults) < "wm" (window
			 * manager chrome) < unlayered styles, so theme.css overrides always
			 * win regardless of source order in the bundled CSS.
			 */
			@layer base, wm;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-border);
					color: var(--color-text);
				}

				:focus-visible {
					outline: 2px solid var(--color-brand);
					outline-offset: 2px;
				}
			}
		</style>

		<style>
			/* ── Waybar ── */
			.waybar {
				position: sticky;
				top: 0;
				z-index: 100;
				height: var(--wm-bar-height);
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: var(--spacing-2);
				padding-inline: var(--wm-gap-out);
				background: color-mix(in srgb, var(--color-bg-subtle) 92%, transparent);
				backdrop-filter: blur(6px);
				border-bottom: 1px solid var(--color-border);
				font-family: var(--font-ui);
				font-size: var(--font-size-xs);
				color: var(--color-text-secondary);
			}

			.waybar-group {
				display: flex;
				align-items: center;
				gap: 0.2rem;
				min-width: 0;
			}

			.waybar-brand {
				display: inline-flex;
				align-items: center;
				gap: var(--spacing-2);
				margin-inline-end: var(--spacing-2);
				color: var(--color-text);
				font-weight: 700;
				white-space: nowrap;
			}

			.waybar-brand:hover {
				color: var(--color-brand);
			}

			.waybar-brand-mark {
				color: var(--color-brand);
			}

			.waybar-logo {
				height: 1.25rem;
				width: auto;
			}

			.workspace,
			.waybar-module {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				height: 1.5rem;
				padding-inline: var(--spacing-2);
				color: var(--color-muted);
				white-space: nowrap;
				transition:
					color var(--transition-fast),
					background-color var(--transition-fast);
			}

			.workspace:hover,
			.waybar-module:hover {
				color: var(--color-text);
				background: var(--color-border);
			}

			.workspace-num {
				opacity: 0.7;
			}

			.workspace[aria-current="page"] {
				color: var(--color-on-brand);
				background: var(--color-brand);
			}

			.workspace[aria-current="page"] .workspace-num {
				opacity: 1;
			}

			.waybar-module svg {
				width: 0.95rem;
				height: 0.95rem;
			}

			.waybar-clock {
				position: absolute;
				left: 50%;
				transform: translateX(-50%);
				color: var(--color-text);
				pointer-events: none;
			}

			/* Search lives in the bar as a compact module */
			:global(.waybar .site-search) {
				position: relative;
				width: var(--search-input-width);
				--emdash-search-border-focus: var(--color-brand);
			}

			:global(.waybar .site-search .site-search-input) {
				width: var(--search-input-width);
				height: 1.5rem;
				padding: 0 var(--spacing-2);
				font-family: var(--font-ui);
				font-size: var(--font-size-xs);
				border: 1px solid var(--color-border);
				border-radius: 0;
				background: var(--color-bg);
				color: var(--color-text);
				transition: border-color var(--transition-fast);
			}

			:global(.waybar .site-search .site-search-input)::placeholder {
				color: var(--color-muted);
			}

			:global(.waybar .site-search .site-search-input):focus,
			:global(.waybar .site-search .site-search-input):focus-visible {
				outline: none;
				border-color: var(--color-brand) !important;
			}

			:global(.site-search-results) {
				position: absolute;
				top: calc(100% + var(--wm-gap-out));
				right: 0;
				width: min(26rem, calc(100vw - 2 * var(--wm-gap-out)));
				padding-top: var(--wm-title-height);
				background: var(--color-bg);
				border: var(--wm-border-width) solid transparent;
				border-image: var(--wm-border-active) 1;
				max-height: 420px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.site-search-results)::before {
				content: "~/search";
				position: absolute;
				top: 0;
				inset-inline: 0;
				height: var(--wm-title-height);
				display: flex;
				align-items: center;
				padding-inline: var(--spacing-3);
				font-size: 0.75rem;
				color: var(--color-brand);
				background: var(--color-bg-subtle);
				border-bottom: 1px solid var(--color-border);
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result) {
				display: block;
				padding: var(--spacing-3) var(--spacing-4);
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background var(--transition-fast);
			}

			:global(.site-search-result):last-child {
				border-bottom: none;
			}

			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
				outline: none;
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-family: var(--font-body);
				font-weight: 600;
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-size: 0.7rem;
				color: var(--color-brand);
				margin-top: 2px;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
				line-height: var(--leading-snug);
			}

			:global(.site-search-result .emdash-live-search-result-snippet mark) {
				font-weight: 600;
				color: var(--color-text);
				background: color-mix(in srgb, var(--om-yellow) 35%, transparent);
			}

			/* Palette picker */
			.palette-picker {
				position: relative;
			}

			.palette-picker summary {
				list-style: none;
				cursor: pointer;
			}

			.palette-picker summary::-webkit-details-marker {
				display: none;
			}

			.palette-picker[open] summary {
				color: var(--color-text);
				background: var(--color-border);
			}

			.palette-dot {
				width: 0.7rem;
				height: 0.7rem;
				background: var(--color-brand);
				box-shadow: inset -0.35rem 0 0 var(--color-text);
			}

			.palette-menu {
				position: absolute;
				top: calc(100% + var(--wm-gap-out));
				right: 0;
				width: 16rem;
				max-height: min(28rem, 70vh);
				overflow-y: auto;
				padding: calc(var(--wm-title-height) + var(--spacing-1)) var(--spacing-1) var(--spacing-1);
				background: var(--color-bg);
				border: var(--wm-border-width) solid transparent;
				border-image: var(--wm-border-active) 1;
				z-index: 1000;
			}

			.palette-menu::before {
				content: "omarchy-theme-set";
				position: absolute;
				top: 0;
				inset-inline: 0;
				height: var(--wm-title-height);
				display: flex;
				align-items: center;
				padding-inline: var(--spacing-3);
				font-size: 0.75rem;
				color: var(--color-brand);
				background: var(--color-bg-subtle);
				border-bottom: 1px solid var(--color-border);
			}

			.palette-option {
				display: grid;
				grid-template-columns: auto 1fr auto;
				align-items: center;
				gap: var(--spacing-2);
				width: 100%;
				padding: var(--spacing-1) var(--spacing-2);
				font: inherit;
				text-align: left;
				color: var(--color-text-secondary);
				background: transparent;
				border: 0;
				cursor: pointer;
			}

			.palette-option:hover,
			.palette-option:focus-visible {
				color: var(--color-text);
				background: var(--color-surface);
			}

			.palette-option[aria-selected="true"] {
				color: var(--color-on-brand);
				background: var(--color-brand);
			}

			.palette-swatch {
				width: 1.6rem;
				height: 0.9rem;
				background: linear-gradient(
					90deg,
					var(--sw-bg) 0 40%,
					var(--sw-fg) 40% 70%,
					var(--sw-accent) 70%
				);
				outline: 1px solid var(--color-border);
			}

			.palette-mode {
				font-size: 0.7rem;
				opacity: 0.7;
			}

			/* ── Footer: a config pane + the status line ── */
			.site-footer {
				width: 100%;
				max-width: var(--wide-width);
				margin-inline: auto;
				display: flex;
				flex-direction: column;
				gap: calc(var(--wm-gap-in) * 2);
			}

			.footer-pane {
				margin-inline: var(--wm-gap-out);
			}

			.footer-grid {
				display: grid;
				grid-template-columns: 2fr 1fr 1fr 1fr;
				gap: var(--spacing-8);
			}

			.footer-logo {
				display: inline-block;
				font-family: var(--font-ui);
				font-size: var(--font-size-lg);
				font-weight: 700;
				color: var(--color-text);
				margin-bottom: var(--spacing-2);
			}

			.footer-logo-img {
				max-height: 32px;
				width: auto;
			}

			.footer-tagline {
				color: var(--color-muted);
				font-size: var(--font-size-sm);
				max-width: 32ch;
			}

			.footer-heading {
				font-family: var(--font-ui);
				font-size: var(--font-size-xs);
				font-weight: 700;
				color: var(--color-text);
				margin-bottom: var(--spacing-3);
			}

			.footer-heading::before {
				content: "❯ ";
				color: var(--color-prompt);
			}

			.footer-links {
				list-style: none;
			}

			.footer-links li {
				margin-bottom: var(--spacing-2);
			}

			.footer-links a {
				font-family: var(--font-ui);
				font-size: var(--font-size-xs);
				color: var(--color-text-secondary);
			}

			.footer-links a:hover {
				color: var(--color-brand);
			}

			.footer-widgets-section :global(.widget-area) {
				display: block;
			}

			.footer-widgets-section :global(.widget) {
				color: var(--color-text-secondary);
			}

			.footer-widgets-section :global(.widget__title) {
				font-family: var(--font-ui);
				font-size: var(--font-size-xs);
				font-weight: 700;
				color: var(--color-text);
				margin-bottom: var(--spacing-3);
			}

			.footer-widgets-section :global(.widget__content) {
				color: var(--color-text-secondary);
				font-size: var(--font-size-sm);
				line-height: var(--leading-relaxed);
			}

			@media (max-width: 1100px) {
				.waybar-clock {
					display: none;
				}
			}

			@media (max-width: 900px) {
				.footer-grid {
					grid-template-columns: 1fr 1fr;
				}

				.footer-brand {
					grid-column: 1 / -1;
				}

				.palette-current {
					display: none;
				}
			}

			@media (max-width: 760px) {
				.workspace-label,
				.waybar-brand-title {
					display: none;
				}

				:global(.waybar .site-search),
				:global(.waybar .site-search .site-search-input) {
					width: 7.5rem;
				}
			}

			@media (max-width: 480px) {
				.footer-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const searchInput = document.querySelector(
						".site-search-input",
					) as HTMLInputElement;
					if (searchInput) {
						searchInput.focus();
					}
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
